<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tap smoke CI only: App Sandbox is disabled so the CI build can write the
	     tap status JSONL under /tmp for the external harness to inspect. This
	     file is never used by Debug/Release production builds. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>

                        <string key="keyEquivalent" base64-UTF8="YES">
IA
</string>
                    </buttonCell>
                    <connections>
                        <action selector="startStopButtonClicked:" target="-2" id="TTc-aS-007"/>
                    </connections>
                </button>
                <slider hidden="YES" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="dWT-uZ-bmy">
                    <rect key="frame" x="421" y="164" width="41" height="28"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxX="YES" flexibleMinY="YES" flexibleMaxY="YES"/>
                    <sliderCell key="cell" continuous="YES" state="on" alignment="left" maxValue="1" tickMarkPosition="above" sliderType="linear" id="aZ1-eT-Nd6"/>
                    <connections>
                        <action selector="dryVolumeChanged:" target="-2" id="TTc-aD-008"/>
                    </connections>
                </slider>
                <textField hidden="YES" focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="Cf6-BH-Y3h">
                    <rect key="frame" x="430" y="194" width="26" height="16"/>
